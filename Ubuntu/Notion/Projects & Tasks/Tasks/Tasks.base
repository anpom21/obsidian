filters:
  and:
    - note["base"] == link("Tasks.base")
properties:
  file.name:
    displayName: Task name
  Last edited time:
    displayName: Last edited time
  Current sprint:
    displayName: Current sprint
  Assignee:
    displayName: Assignee
  Status:
    displayName: Status
  Due:
    displayName: Due
  Priority:
    displayName: Priority
  Project:
    displayName: Project
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Last edited time
      - Current sprint
      - Assignee
      - Status
      - Due
      - Priority
      - Project
    columnSize:
      file.name: 417
